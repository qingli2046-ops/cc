//@version=6
indicator("15m Displacement Low v17", shorttitle = "DL15 v17", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// v17 - two-candle higher-low formation with no minimum D distance.
//   Candle 2 must make a higher low, and at least one formation candle must be green.
//   R (stop distance) = C2 - L2           must be >= minRiskPts
//   Entry = C2 close, stop = L2. Optional TP floor/cap clamp R to the selected range.
//   Candle 3 executes only when it is green and receives a green dot below it.
//   Starting with candle 3, the active TP is checked before SL on each 15m
//   candle. The outcome candle receives a check or X above it. A candle touching
//   both is a TP success, permanently.
//   Patterns: A = G/G, B = R/G, C = G/R only when candle 2's lower wick is at least
//   wickPct of its range. A red candle 2 with a short wick (the old "D" case) never
//   qualifies. No D/R ratio gate; the ratio is shown for information only.

// ---------------------------------------------------------------- rules
float minDPts    = 0.0
float minRiskPts = input.float(10.0, "Minimum R  (points)", minval = 0.0, step = 1.0, group = "Stop (R = C2 - L2)", tooltip = "Absolute floor so the stop is never inside normal liquidity noise.")
// Either formation candle may be green.
// Pattern C has no wick requirement in v13.
bool  useMaxTp   = input.bool(true, "Limit TP distance", group = "Outcomes", tooltip = "When enabled, TP uses the smaller of 1R and the maximum TP distance.")
float maxTpPts   = input.float(100.0, "Maximum TP  (points)", minval = 0.25, step = 0.25, group = "Outcomes")
bool  useMinTp   = input.bool(true, "Minimum TP distance", group = "Outcomes", tooltip = "When enabled, TP is at least this distance even when 1R is smaller.")
float minTpPts   = input.float(30.0, "Minimum TP  (points)", minval = 0.25, step = 0.25, group = "Outcomes")

// ---------------------------------------------------------------- display
int    drawnZones = input.int(6, "Zones drawn on chart", minval = 1, maxval = 40, group = "Display")
int    monitored  = input.int(50, "Setups monitored (invisible)", minval = 1, maxval = 150, group = "Display")
string labelMode  = input.string("Latest only", "Setup labels", options = ["None", "Latest only", "All drawn"], group = "Display")
bool   keepTested = input.bool(true, "Keep tested zones on chart", group = "Display")
bool   showMarks  = input.bool(true, "Show execution dot / check / X markers", group = "Display")
bool   showPanel  = input.bool(true, "Show panel", group = "Display")
color  zoneColor  = input.color(#26A69A, "Zone", group = "Display")
color  starColor  = input.color(#00BFA5, "Strong-close zone", group = "Display")
color  stopColor  = input.color(#EF5350, "Stop", group = "Display")
color  testedColor = input.color(#78909C, "Tested", group = "Display")

if barstate.isfirst
    if not (timeframe.isminutes and timeframe.multiplier == 15)
        runtime.error("Use a 15-minute chart. Both pattern candles must be 15-minute candles.")
    if not chart.is_standard
        runtime.error("Use standard candles or bars.")

type Setup
    box   zoneBox
    box   riskBox
    line  entryLine
    line  stopLine
    line  tpLine
    label tag
    label executionMarker
    label outcomeMarker
    float stopPrice
    float entryPrice
    float tpPrice
    float dPts
    float rPts
    string pattern
    bool  strong
    int   createdBar
    bool  tested = false
    bool  drawn  = false
    int   outcome = 0

var array<Setup> setups = array.new<Setup>()

priceText(float v) =>
    str.tostring(v, format.mintick)

clearDrawing(Setup s) =>
    box.delete(s.zoneBox)
    box.delete(s.riskBox)
    line.delete(s.entryLine)
    line.delete(s.stopLine)
    line.delete(s.tpLine)
    label.delete(s.tag)
    s.zoneBox := na
    s.riskBox := na
    s.entryLine := na
    s.stopLine := na
    s.tpLine := na
    s.tag := na
    s.drawn := false

wipe(Setup s) =>
    clearDrawing(s)
    label.delete(s.executionMarker)
    label.delete(s.outcomeMarker)

// ---------------------------------------------------------------- measurements
float D         = low - low[1]
float R         = close - low
float rng       = high - low
float closeFromLow = close - low
// No lower-wick filter.
float dMin      = minDPts
float rMin      = minRiskPts
float flooredTpDistance = useMinTp ? math.max(R, minTpPts) : R
float tpDistance = useMaxTp ? math.min(flooredTpDistance, maxTpPts) : flooredTpDistance

bool green1 = close[1] > open[1]
bool red1   = close[1] < open[1]
bool green2 = close > open
bool red2   = close < open

bool patA = green1 and green2
bool patB = red1 and green2
bool patC = green1 and red2
bool shapeOk = green1 or green2

bool dispOk = D > 0 and D >= dMin
bool riskOk = R > 0 and R >= rMin
bool strong = green2 and rng > 0 and closeFromLow / rng >= 0.66

bool newSetup = barstate.isconfirmed and bar_index > 0 and shapeOk and dispOk and riskOk
string pattern = patA ? "A  G/G" : patB ? "B  R/G" : patC ? "C  G/R" : "GREEN + DOJI"

// ---------------------------------------------------------------- monitor
bool tpFirstThisBar = false
bool stopFirstThisBar = false
if array.size(setups) > 0
    for i = array.size(setups) - 1 to 0
        Setup s = array.get(setups, i)
        // Candle 3 executes only when green; otherwise cancel the setup.
        if s.outcome == 0 and bar_index == s.createdBar + 1 and close <= open
            s.outcome := 2
            s.tested := true
            clearDrawing(s)
        // The first eligible candle is the green bar immediately after candle 2.
        if s.outcome == 0 and bar_index > s.createdBar
            if bar_index == s.createdBar + 1 and showMarks and na(s.executionMarker)
                s.executionMarker := label.new(x = time, y = low, text = "●", xloc = xloc.bar_time, yloc = yloc.belowbar, style = label.style_none, textcolor = color.new(starColor, 0), size = size.small, tooltip = "Long execution: pattern candle 3")
            if s.drawn
                box.set_right(s.zoneBox, time_close)
                box.set_right(s.riskBox, time_close)
                line.set_x2(s.entryLine, time_close)
                line.set_x2(s.stopLine, time_close)
                line.set_x2(s.tpLine, time_close)
            // Fifteen-minute rule: TP has priority when the same candle spans both
            // levels. This lets candle 3 record its target immediately as a success.
            int result = high >= s.tpPrice ? 1 : low <= s.stopPrice ? -1 : 0
            if result != 0
                s.outcome := result
                s.tested := true
                tpFirstThisBar := tpFirstThisBar or result == 1
                stopFirstThisBar := stopFirstThisBar or result == -1
                if showMarks
                    s.outcomeMarker := label.new(x = time, y = high, text = result == 1 ? "✓" : "✕", xloc = xloc.bar_time, yloc = yloc.abovebar, style = label.style_none, textcolor = result == 1 ? color.new(starColor, 0) : color.new(stopColor, 0), size = size.small, tooltip = result == 1 ? "TP success: 1R target reached (TP has same-bar priority)" : "SL first: stop reached before a 1R target candle")
                if keepTested and s.drawn
                    color resultColor = result == 1 ? starColor : testedColor
                    box.set_bgcolor(s.zoneBox, color.new(resultColor, 97))
                    box.set_border_color(s.zoneBox, color.new(resultColor, 70))
                    box.set_bgcolor(s.riskBox, color.new(resultColor, 97))
                    box.set_border_color(s.riskBox, color.new(resultColor, 70))
                    line.set_color(s.entryLine, color.new(resultColor, 60))
                    line.set_color(s.stopLine, color.new(resultColor, 60))
                    line.set_color(s.tpLine, color.new(resultColor, 60))
                    line.set_style(s.entryLine, line.style_dotted)
                    line.set_style(s.stopLine, line.style_dotted)
                    line.set_style(s.tpLine, line.style_dotted)
                    label.delete(s.tag)
                    s.tag := na
                else
                    clearDrawing(s)

// ---------------------------------------------------------------- new setup
if newSetup
    if array.size(setups) >= monitored
        Setup oldest = array.shift(setups)
        wipe(oldest)
    int liveDrawn = 0
    if array.size(setups) > 0
        for i = array.size(setups) - 1 to 0
            Setup s = array.get(setups, i)
            if s.drawn
                liveDrawn += 1
                if liveDrawn >= drawnZones
                    clearDrawing(s)
            if labelMode == "Latest only" and not na(s.tag)
                label.delete(s.tag)
                s.tag := na

    color zc = strong ? starColor : zoneColor
    float target = close + tpDistance
    // C is drawn hollow with a dashed edge so it reads as the weaker case
    box z = box.new(left = time[1], top = math.max(low, low[1]), right = time_close, bottom = math.min(low, low[1]), xloc = xloc.bar_time, border_color = color.new(zc, patC ? 30 : 55), border_width = 1, border_style = patC ? line.style_dashed : line.style_solid, bgcolor = color.new(zc, patC ? 100 : (strong ? 86 : 93)), text = "D " + priceText(D), text_color = color.new(zc, 10), text_size = size.tiny)
    box rb = box.new(left = time, top = close, right = time_close, bottom = low, xloc = xloc.bar_time, border_color = color.new(stopColor, 35), border_width = 1, bgcolor = color.new(stopColor, 92), text = "R " + priceText(R), text_color = color.new(stopColor, 5), text_size = size.tiny)
    line en = line.new(x1 = time, y1 = close, x2 = time_close, y2 = close, xloc = xloc.bar_time, color = color.new(chart.fg_color, 35), width = 1)
    line sl = line.new(x1 = time, y1 = low, x2 = time_close, y2 = low, xloc = xloc.bar_time, color = color.new(stopColor, 35), width = 1)
    line tp = line.new(x1 = time, y1 = target, x2 = time_close, y2 = target, xloc = xloc.bar_time, color = color.new(starColor, 20), width = 1)
    label tag = na
    if labelMode != "None"
        string t = (strong ? "★ " : "") + priceText(D) + "D · " + priceText(R) + "R"
        tag := label.new(x = time, y = low, text = t, xloc = xloc.bar_time, style = label.style_none, textcolor = color.new(zc, 15), size = size.tiny)
    label executionMarker = na
    label outcomeMarker = na
    array.push(setups, Setup.new(z, rb, en, sl, tp, tag, executionMarker, outcomeMarker, low, close, target, D, R, pattern, strong, bar_index, false, true, 0))

// ---------------------------------------------------------------- readout
int liveCount = 0
if barstate.islast and array.size(setups) > 0
    for i = 0 to array.size(setups) - 1
        if not array.get(setups, i).tested
            liveCount += 1

plot(newSetup ? close : na, title = "Entry", display = display.data_window)
plot(newSetup ? low : na, title = "Stop", display = display.data_window)
plot(newSetup ? close + tpDistance : na, title = "TP", display = display.data_window)
plot(newSetup ? D : na, title = "D pts", display = display.data_window)
plot(newSetup ? R : na, title = "R pts", display = display.data_window)
plot(dMin, title = "D minimum", display = display.data_window)
plot(rMin, title = "R minimum", display = display.data_window)

alertcondition(newSetup, title = "New displacement setup", message = "15m bullish displacement setup confirmed.")
alertcondition(newSetup and strong, title = "New strong-close setup", message = "15m bullish displacement setup with a strong close.")
alertcondition(tpFirstThisBar, title = "1R TP success", message = "A monitored setup reached its 1R TP. TP has priority when both levels occur in one 15m candle.")
alertcondition(stopFirstThisBar, title = "SL first", message = "A monitored setup reached its stop before its 1R TP.")

var table panel = table.new(position.top_right, 2, 9, border_width = 0, frame_width = 1, frame_color = color.new(color.gray, 70))
if barstate.islast and showPanel
    color bg  = color.new(chart.bg_color, 15)
    color ink = chart.fg_color
    color dim = color.new(chart.fg_color, 45)
    bool has = array.size(setups) > 0
    string head = "WAITING"
    if has
        Setup newest = array.get(setups, array.size(setups) - 1)
        head := (newest.outcome == 1 ? "TP SUCCESS ✓" : newest.outcome == -1 ? "SL FIRST ✕" : newest.outcome == 2 ? "NO ENTRY" : "LIVE") + (newest.strong ? "  ★" : "")
    table.cell(panel, 0, 0, "DL15", bgcolor = color.new(zoneColor, 20), text_color = color.white, text_size = size.small)
    table.cell(panel, 1, 0, head, bgcolor = color.new(zoneColor, 20), text_color = color.white, text_size = size.small)
    table.cell(panel, 0, 1, "min D / R", bgcolor = bg, text_color = dim, text_size = size.small)
    table.cell(panel, 1, 1, priceText(dMin) + " / " + priceText(rMin), bgcolor = bg, text_color = dim, text_size = size.small)
    if has
        Setup last = array.get(setups, array.size(setups) - 1)
        table.cell(panel, 0, 2, "pattern", bgcolor = bg, text_color = dim, text_size = size.small)
        table.cell(panel, 1, 2, last.pattern, bgcolor = bg, text_color = ink, text_size = size.small)
        table.cell(panel, 0, 3, "entry", bgcolor = bg, text_color = dim, text_size = size.small)
        table.cell(panel, 1, 3, priceText(last.entryPrice), bgcolor = bg, text_color = ink, text_size = size.small)
        table.cell(panel, 0, 4, "stop", bgcolor = bg, text_color = dim, text_size = size.small)
        table.cell(panel, 1, 4, priceText(last.stopPrice), bgcolor = bg, text_color = stopColor, text_size = size.small)
        table.cell(panel, 0, 5, "D", bgcolor = bg, text_color = dim, text_size = size.small)
        table.cell(panel, 1, 5, priceText(last.dPts), bgcolor = bg, text_color = ink, text_size = size.small)
        table.cell(panel, 0, 6, "R", bgcolor = bg, text_color = dim, text_size = size.small)
        table.cell(panel, 1, 6, priceText(last.rPts), bgcolor = bg, text_color = ink, text_size = size.small)
        table.cell(panel, 0, 7, "D / R", bgcolor = bg, text_color = dim, text_size = size.small)
        table.cell(panel, 1, 7, str.tostring(last.dPts / last.rPts, "#.##"), bgcolor = bg, text_color = ink, text_size = size.small)
        table.cell(panel, 0, 8, "TP / tracked", bgcolor = bg, text_color = dim, text_size = size.small)
        table.cell(panel, 1, 8, priceText(last.tpPrice) + " / " + str.tostring(liveCount) + " live", bgcolor = bg, text_color = ink, text_size = size.small)
