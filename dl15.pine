//@version=6
indicator("15m Displacement Low v18", shorttitle = "DL15 v18", overlay = true, max_boxes_count = 500, max_labels_count = 500)

// DL15 v18: 15m two-candle higher-low long, scored as a live scalp.
//
// FORMATION  (C1, C2 = two consecutive 15m candles)
//   - C2 low is above C1 low (higher low). D = C2 low - C1 low, for information.
//   - At least one of C1 / C2 is green.
//   - R = C2 close - C2 low. The setup counts only when R >= Minimum SL (default 30).
//   - Pattern, information only: A = G/G, B = R/G, C = G/R, "doji" = one flat candle.
//     ★ = C2 green and closing in the top part of its range.
//
// TRADE  (entry = C2 close = C3 open; the C3 close is never used as an entry)
//   - Stop = C2 low, exactly 1R below entry.
//   - Win TP = entry + 25 (fixed). Reaching it scores a win.
//   - Visual TP = entry + 1R, or entry + 30 when 1R is smaller than 30. Drawn as a
//     dashed box above the win TP. It is a visual aid only and does not affect scoring.
//
// CANDLE 3  (every setup is a trade from C3 open, whatever C3 does)
//   - C3 closes green: green dot under C3.
//   - C3 closes red or flat: amber ⚠ under C3 and the setup turns amber. The trade stays
//     live and scored. Treat it as weak: tighten the stop or exit early, do not add.
//
// SCORING  (from C3 on, each 15m candle)
//   - Win when the high reaches the win TP, loss when the low reaches the stop.
//     ✓ / ✕ above the candle.
//   - A candle reaching both levels is settled with 1m data (first touch wins). With no
//     1m data, or when one 1m candle reaches both, it counts as a loss (see settings).
//   - A loss that opens beyond the stop (session gap) is booked at the open.
//   - Panel: W / L, win %, net and average points over the loaded history, split by C3
//     colour, plus what the red-C3 trades made if closed at the C3 close instead.

// ---------------------------------------------------------------- inputs
float  minRiskPts = input.float(30.0, "Minimum SL / R  (points)", minval = 0.25, step = 0.25, group = "Trade", tooltip = "R = C2 close - C2 low. Setups with a smaller R are ignored and never scored.")
float  winTpPts   = input.float(25.0, "Win TP  (points)", minval = 0.25, step = 0.25, group = "Trade", tooltip = "A trade scores a win when price reaches entry + this distance.")
float  visTpMin   = input.float(30.0, "Visual TP minimum  (points)", minval = 0.25, step = 0.25, group = "Trade", tooltip = "The drawn TP is 1R, or this distance when 1R is smaller. Visual only, never scored.")
string tieMode    = input.string("1m data, else loss", "Candle reaches win TP and stop", options = ["1m data, else loss", "Always loss", "Always win"], group = "Trade", tooltip = "How a 15m candle that reaches both levels is scored. 1m data checks which level came first; when it cannot tell, the candle counts as a loss.")
float  strongPct  = input.float(66.0, "★ strong close  (% of C2 range)", minval = 0.0, maxval = 100.0, step = 1.0, group = "Trade")

int    drawnZones = input.int(6, "Setups drawn on chart", minval = 1, maxval = 40, group = "Display")
int    monitored  = input.int(50, "Setups monitored (invisible)", minval = 1, maxval = 150, group = "Display")
string labelMode  = input.string("Latest only", "Setup labels", options = ["None", "Latest only", "All drawn"], group = "Display")
bool   keepTested = input.bool(true, "Keep finished setups on chart", group = "Display")
bool   showMarks  = input.bool(true, "Show C3 dot / ⚠ and ✓ / ✕ markers", group = "Display")
bool   showPanel  = input.bool(true, "Show panel", group = "Display")
color  zoneColor  = input.color(#26A69A, "Zone", group = "Display")
color  starColor  = input.color(#00BFA5, "Strong close / win", group = "Display")
color  stopColor  = input.color(#EF5350, "Stop / loss", group = "Display")
color  warnColor  = input.color(#FFA726, "C3 red warning", group = "Display")
color  doneColor  = input.color(#78909C, "Finished", group = "Display")

if barstate.isfirst
    if not (timeframe.isminutes and timeframe.multiplier == 15)
        runtime.error("Use a 15-minute chart. Both pattern candles must be 15-minute candles.")
    if not chart.is_standard
        runtime.error("Use standard candles or bars.")

// ---------------------------------------------------------------- types
type Setup
    box    zoneBox
    box    riskBox
    box    winBox
    box    visBox
    label  tag
    float  entry
    float  stop
    float  tp
    float  visTp
    float  rPts
    float  dPts
    string pattern
    bool   strong
    int    createdBar
    int    c3      = 0      // 1 = C3 closed green, -1 = red or flat, 0 = not closed yet
    int    outcome = 0      // 1 = win, -1 = loss, 0 = open
    float  pnl     = 0.0    // points, from entry to exit
    bool   drawn   = true

type Tally
    int   wins   = 0
    int   losses = 0
    float pts    = 0.0

var array<Setup> setups = array.new<Setup>()
var Tally allTally     = Tally.new()
var Tally greenTally   = Tally.new()
var Tally redTally     = Tally.new()
var Tally redExitTally = Tally.new()
var int   ties         = 0
var int   tiesBy1m     = 0
var int   dropped      = 0

// ---------------------------------------------------------------- helpers
priceText(float v) =>
    str.tostring(v, format.mintick)

num(float v) =>
    str.tostring(v, "#.##")

signed(float v) =>
    (v > 0 ? "+" : "") + num(v)

tagText(string pat, bool isStrong, float rp, float winp, float visp, bool weak) =>
    (isStrong ? "★ " : "") + pat + "  R " + num(rp) + "  win +" + num(winp) + "  TP +" + num(visp) + (weak ? "  ⚠ C3 red" : "")

tint(box b, color c, int fillT, int edgeT) =>
    box.set_bgcolor(b, color.new(c, fillT))
    box.set_border_color(b, color.new(c, edgeT))
    box.set_text_color(b, color.new(c, edgeT))

fadeBox(box b, color c) =>
    tint(b, c, 96, 70)
    box.set_border_style(b, line.style_dotted)

extendTo(Setup s, int t) =>
    box.set_right(s.zoneBox, t)
    box.set_right(s.riskBox, t)
    box.set_right(s.winBox, t)
    box.set_right(s.visBox, t)

clearDrawing(Setup s) =>
    box.delete(s.zoneBox)
    box.delete(s.riskBox)
    box.delete(s.winBox)
    box.delete(s.visBox)
    label.delete(s.tag)
    s.tag   := na
    s.drawn := false

finish(Setup s, color c) =>
    fadeBox(s.zoneBox, c)
    fadeBox(s.riskBox, c)
    fadeBox(s.winBox, c)
    fadeBox(s.visBox, c)
    label.delete(s.tag)
    s.tag := na

addPts(Tally t, float pts) =>
    if pts > 0
        t.wins := t.wins + 1
    else
        t.losses := t.losses + 1
    t.pts := t.pts + pts

tallyText(Tally t) =>
    int n = t.wins + t.losses
    n == 0 ? "no trades yet" : str.tostring(t.wins) + "W " + str.tostring(t.losses) + "L · " + str.tostring(100.0 * t.wins / n, "#") + "% · net " + signed(t.pts) + " · avg " + signed(t.pts / n)

// First 1m candle to reach a level settles a 15m candle that reached both.
// 1 = TP first, -1 = stop first, 0 = no 1m data, or one 1m candle reached both.
firstTouch(float tp, float stop, array<float> hs, array<float> ls) =>
    int first = 0
    for [i, h] in hs
        bool hitTp   = h >= tp
        bool hitStop = array.get(ls, i) <= stop
        if hitTp or hitStop
            first := hitTp == hitStop ? 0 : hitTp ? 1 : -1
            break
    first

panelRow(table tb, int r, string k, string v, color bg, color kc, color vc) =>
    table.cell(tb, 0, r, k, bgcolor = bg, text_color = kc, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, r, v, bgcolor = bg, text_color = vc, text_size = size.small, text_halign = text.align_left)

// ---------------------------------------------------------------- measurements
float D   = low - low[1]
float R   = close - low
float rng = high - low

bool green1 = close[1] > open[1]
bool red1   = close[1] < open[1]
bool green2 = close > open
bool red2   = close < open

float visDist = math.max(R, visTpMin)

bool   strong   = green2 and rng > 0 and (close - low) / rng >= strongPct / 100.0
bool   newSetup = barstate.isconfirmed and bar_index > 0 and (green1 or green2) and D > 0 and R > 0 and R >= minRiskPts
string pattern  = green1 and green2 ? "A  G/G" : red1 and green2 ? "B  R/G" : green1 and red2 ? "C  G/R" : "doji + G"

// 1m highs and lows inside the current 15m candle, used only for candles reaching both levels.
[ltfHigh, ltfLow] = request.security_lower_tf(syminfo.tickerid, "1", [high, low])

// ---------------------------------------------------------------- monitor open trades
bool tpHit   = false
bool stopHit = false
bool weakNow = false
for s in setups
    if s.outcome != 0 or bar_index <= s.createdBar
        continue
    bool isC3 = bar_index == s.createdBar + 1
    if isC3
        s.c3 := close > open ? 1 : -1
    if s.drawn
        extendTo(s, time_close)

    bool   hitTp   = high >= s.tp
    bool   hitStop = low <= s.stop
    int    result  = hitTp == hitStop ? 0 : hitTp ? 1 : -1
    string how     = ""
    if hitTp and hitStop
        int first = tieMode == "1m data, else loss" ? firstTouch(s.tp, s.stop, ltfHigh, ltfLow) : 0
        ties     += 1
        tiesBy1m += first != 0 ? 1 : 0
        how      := first != 0 ? "\nSame candle: 1m data shows the " + (first == 1 ? "TP" : "stop") + " first." : "\nSame candle, order unknown: scored by the setting."
        result   := first != 0 ? first : tieMode == "Always win" ? 1 : -1

    if result != 0
        s.outcome := result
        s.pnl     := (result == 1 ? s.tp : math.min(s.stop, open)) - s.entry
        Tally grp = s.c3 == 1 ? greenTally : redTally
        addPts(allTally, s.pnl)
        addPts(grp, s.pnl)
        tpHit   := tpHit or result == 1
        stopHit := stopHit or result == -1
        if showMarks
            label.new(x = time, y = high, text = result == 1 ? "✓" : "✕", xloc = xloc.bar_time, yloc = yloc.abovebar, style = label.style_none, textcolor = result == 1 ? starColor : stopColor, size = size.small, tooltip = (result == 1 ? "Win: win TP reached, " : "Loss: stop reached, ") + signed(s.pnl) + " pts." + how)
        if s.drawn
            if keepTested
                finish(s, result == 1 ? starColor : doneColor)
            else
                clearDrawing(s)

    // Candle 3 verdict, taken at its close. Colour is not final while C3 is forming.
    if isC3 and barstate.isconfirmed
        if s.c3 == -1
            addPts(redExitTally, s.outcome != 0 ? s.pnl : close - s.entry)
            if s.outcome == 0
                weakNow := true
                if s.drawn
                    tint(s.zoneBox, warnColor, 85, 35)
                    tint(s.winBox, warnColor, 85, 35)
                    if not na(s.tag)
                        label.set_text(s.tag, tagText(s.pattern, s.strong, s.rPts, s.tp - s.entry, s.visTp - s.entry, true))
                        label.set_textcolor(s.tag, color.new(warnColor, 0))
        if showMarks
            label.new(x = time, y = low, text = s.c3 == 1 ? "●" : "⚠", xloc = xloc.bar_time, yloc = yloc.belowbar, style = label.style_none, textcolor = s.c3 == 1 ? starColor : warnColor, size = size.small, tooltip = s.c3 == 1 ? "C3 closed green: trade confirmed." : s.outcome != 0 ? "C3 closed red. The trade already finished on this candle." : "C3 closed red: weak trade.\nTighten the stop or exit early. Do not add.")

// ---------------------------------------------------------------- new setup
if newSetup
    // Keep the newest drawings, drop finished setups nobody can see.
    if array.size(setups) > 0
        int shown = 0
        for i = array.size(setups) - 1 to 0
            Setup s = array.get(setups, i)
            if s.drawn
                shown += 1
                if shown >= drawnZones
                    clearDrawing(s)
            if labelMode == "Latest only"
                label.delete(s.tag)
                s.tag := na
            if s.outcome != 0 and not s.drawn
                array.remove(setups, i)
    // Still full: remove a finished setup first; an open one only if none is finished.
    if array.size(setups) >= monitored
        int victim = 0
        for [i, s] in setups
            if s.outcome != 0
                victim := i
                break
        Setup old = array.remove(setups, victim)
        clearDrawing(old)
        if old.outcome == 0
            dropped += 1

    color  zc     = strong ? starColor : zoneColor
    float  winPx  = close + winTpPts
    float  visPx  = close + visDist
    bool   same   = math.abs(visPx - winPx) < syminfo.mintick / 2
    string visTxt = (visDist > R ? "TP +" + num(visDist) + " (1R " + num(R) + ")" : "TP 1R +" + num(R))
    box zb = box.new(left = time[1], top = low, right = time_close, bottom = low[1], xloc = xloc.bar_time, border_color = color.new(zc, 55), bgcolor = color.new(zc, strong ? 86 : 93), text = "D " + num(D), text_color = color.new(zc, 10), text_size = size.tiny)
    box rb = box.new(left = time, top = close, right = time_close, bottom = low, xloc = xloc.bar_time, border_color = color.new(stopColor, 35), bgcolor = color.new(stopColor, 90), text = "SL -" + num(R), text_color = color.new(stopColor, 5), text_size = size.tiny)
    box wb = box.new(left = time, top = winPx, right = time_close, bottom = close, xloc = xloc.bar_time, border_color = color.new(zc, 35), bgcolor = color.new(zc, 88), text = "win +" + num(winTpPts) + (same ? " = " + visTxt : ""), text_color = color.new(zc, 5), text_size = size.tiny)
    box vb = box.new(left = time, top = math.max(winPx, visPx), right = time_close, bottom = math.min(winPx, visPx), xloc = xloc.bar_time, border_color = color.new(chart.fg_color, 55), border_style = line.style_dashed, bgcolor = color.new(chart.fg_color, 100), text = same ? "" : visTxt, text_color = color.new(chart.fg_color, 35), text_size = size.tiny, text_valign = text.align_top)
    label tg = na
    if labelMode != "None"
        tg := label.new(x = time, y = low[1], text = tagText(pattern, strong, R, winTpPts, visDist, false), xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_up, color = color.new(zc, 100), textcolor = color.new(zc, 10), size = size.tiny)
    array.push(setups, Setup.new(zoneBox = zb, riskBox = rb, winBox = wb, visBox = vb, tag = tg, entry = close, stop = low, tp = winPx, visTp = visPx, rPts = R, dPts = D, pattern = pattern, strong = strong, createdBar = bar_index))

// ---------------------------------------------------------------- data window + alerts
plot(newSetup ? close : na, "Entry", display = display.data_window)
plot(newSetup ? low : na, "Stop", display = display.data_window)
plot(newSetup ? close + winTpPts : na, "Win TP", display = display.data_window)
plot(newSetup ? close + visDist : na, "Visual TP", display = display.data_window)
plot(newSetup ? R : na, "R pts", display = display.data_window)
plot(newSetup ? D : na, "D pts", display = display.data_window)

alertcondition(newSetup, "New setup", 'DL15 long {{ticker}}: entry {{close}} (C2 close / C3 open), stop {{low}}, win TP {{plot("Win TP")}}, visual TP {{plot("Visual TP")}}')
alertcondition(newSetup and strong, "New strong-close setup", 'DL15 ★ long {{ticker}}: entry {{close}} (C2 close / C3 open), stop {{low}}, win TP {{plot("Win TP")}}, visual TP {{plot("Visual TP")}}')
alertcondition(weakNow, "C3 red warning", "DL15 ⚠ {{ticker}} candle 3 closed red: weak trade. Tighten the stop or exit early. Do not add.")
alertcondition(tpHit, "Win TP hit", "DL15 {{ticker}}: an open trade reached its win TP.")
alertcondition(stopHit, "Stop hit", "DL15 {{ticker}}: an open trade reached its stop.")

// ---------------------------------------------------------------- panel
var table panel = table.new(position.top_right, 2, 13, border_width = 0, frame_width = 1, frame_color = color.new(color.gray, 70))
if barstate.islast and showPanel
    color  bg     = color.new(chart.bg_color, 15)
    color  ink    = chart.fg_color
    color  dim    = color.new(chart.fg_color, 45)
    string head   = "WAITING"
    color  headBg = color.new(zoneColor, 20)
    int openCount = 0
    for s in setups
        openCount += s.outcome == 0 ? 1 : 0
    if array.size(setups) > 0
        Setup cur     = array.last(setups)
        bool  forming = bar_index == cur.createdBar + 1 and not barstate.isconfirmed
        float tpPts   = cur.tp - cur.entry
        float visPts  = cur.visTp - cur.entry
        head := cur.outcome == 1 ? "WIN ✓  " + signed(cur.pnl) : cur.outcome == -1 ? "LOSS ✕  " + signed(cur.pnl) : bar_index == cur.createdBar ? "NEW · enter at open" : forming ? "LIVE · C3 forming" : cur.c3 == 1 ? "LIVE · C3 green" : "LIVE ⚠ WEAK · C3 red"
        if cur.outcome == 0 and cur.c3 == -1 and not forming
            headBg := color.new(warnColor, 10)
        panelRow(panel, 1, "setup", (cur.strong ? "★ " : "") + cur.pattern, bg, dim, ink)
        panelRow(panel, 2, "entry", priceText(cur.entry) + "  C2 close", bg, dim, ink)
        panelRow(panel, 3, "stop", priceText(cur.stop) + "  -" + num(cur.rPts), bg, dim, stopColor)
        panelRow(panel, 4, "win TP", priceText(cur.tp) + "  +" + num(tpPts), bg, dim, starColor)
        panelRow(panel, 5, "visual TP", priceText(cur.visTp) + "  +" + num(visPts) + (visPts > cur.rPts + syminfo.mintick / 2 ? "  (minimum)" : "  (1R)"), bg, dim, ink)
        panelRow(panel, 6, "win/R · D", num(tpPts / cur.rPts) + " · D " + num(cur.dPts), bg, dim, ink)
    table.cell(panel, 0, 0, "DL15", bgcolor = headBg, text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 1, 0, head, bgcolor = headBg, text_color = color.white, text_size = size.small, text_halign = text.align_left)
    panelRow(panel, 7, "all trades", tallyText(allTally), bg, dim, ink)
    panelRow(panel, 8, "C3 green", tallyText(greenTally), bg, dim, ink)
    panelRow(panel, 9, "C3 red, held", tallyText(redTally), bg, dim, warnColor)
    panelRow(panel, 10, "C3 red, out at C3 close", tallyText(redExitTally), bg, dim, warnColor)
    panelRow(panel, 11, "open trades", str.tostring(openCount) + (dropped > 0 ? " · " + str.tostring(dropped) + " dropped unscored" : ""), bg, dim, ink)
    panelRow(panel, 12, "TP + stop same candle", str.tostring(ties) + " · " + str.tostring(tiesBy1m) + " settled by 1m", bg, dim, ink)
